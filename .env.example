# Dedicated hackathon paper account (one email, $100,000 starting balance).
# Create keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Optional: LLM thesis writer. Heuristic proposer runs if unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hard safety. true = no new entries, supervisor may still flatten.
TRADENUM_KILL_SWITCH=false
TRADENUM_MAX_LOSS_PER_TICKET=750
TRADENUM_MAX_OPEN_TICKETS=4
TRADENUM_MAX_PER_UNDERLYING=1
TRADENUM_LEDGER_PATH=data/tradenum.db

# Optional. Front-end desk presence (web/.env.local). Do not commit secrets.
# NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
# LIVEBLOCKS_SECRET_KEY=
